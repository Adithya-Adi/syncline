# Copy to .env.production and fill in. Used by docker-compose.prod.yml.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Nothing here has a working default on purpose. Every value below either points at infrastructure
# only you know about, or is a secret — and a default secret is worse than a missing one, because a
# missing one stops the container and a default one runs.

# --------------------------------------------------------------------------------------------
# Infrastructure
# --------------------------------------------------------------------------------------------

# Managed Postgres, or `postgresql://syncline:PASSWORD@postgres:5432/syncline` with the bundled
# profile. Add `?sslmode=require` for anything crossing a network you do not own.
DATABASE_URL=

# Managed Redis, or `redis://redis:6379` with the bundled profile.
#
# Must run with `maxmemory-policy noeviction`. BullMQ uses blocking reads and cannot survive keys
# being evicted underneath it — a Redis configured to evict loses jobs silently under pressure.
REDIS_URL=

# S3, R2, MinIO — anything with the API. `http://minio:9000` with the bundled profile.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=syncline
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO and most self-hosted stores need path-style addressing. S3 and R2 do not.
S3_FORCE_PATH_STYLE=false

# --------------------------------------------------------------------------------------------
# The dashboard
# --------------------------------------------------------------------------------------------

# Signs session cookies. Generate one per install and never share it between environments:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# The dashboard's own public URL, scheme included. Sign-in redirects and cookie domains are built
# from it, so a wrong value here fails as "signed in, then immediately signed out".
BETTER_AUTH_URL=https://syncline.example.com

# --------------------------------------------------------------------------------------------
# Sizing and ports
# --------------------------------------------------------------------------------------------

# Host ports. Both services expect to sit behind a proxy that terminates TLS.
WEB_PORT=3000
API_PORT=4000

# What one project may send. These are the only bounds on *how many* requests arrive — every other
# limit in the ingest path bounds a single one. The public key ships in a browser bundle by design
# and Origin is browser-enforced, so without these anybody who reads a bundle can write without
# bound. Set either to 0 to disable it, which is reasonable only on a private network.
INGEST_REQUESTS_PER_MINUTE=1200
INGEST_BYTES_PER_DAY=5368709120

# Jobs one worker process handles at once. Raise it before adding processes: the work is IO-bound
# on Postgres and the object store, so concurrency is cheaper than another Node heap.
WORKER_CONCURRENCY=4

# --------------------------------------------------------------------------------------------
# Bundled infrastructure only (the `bundled` profile)
# --------------------------------------------------------------------------------------------
POSTGRES_USER=syncline
POSTGRES_PASSWORD=
POSTGRES_DB=syncline
