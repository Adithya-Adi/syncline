// Syncline data model. See docs/ARCHITECTURE.md §6 for the reasoning behind the shape.
//
// Two rules this schema exists to enforce:
//   1. rrweb blobs never land in Postgres. A five-minute session is tens of megabytes of DOM
//      mutations. Postgres holds the index; object storage holds the film.
//   2. Spans are reached through the SpanStore port, never through this client directly. They are
//      the one table with unbounded write volume and the one destined for ClickHouse.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id             String       @id @default(cuid())
  name           String
  /// The tenant boundary. Every recording reaches an organization through its project.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// pk_* — ships in browser bundles. Public by construction: write-only and origin-gated,
  /// so it is stored as-is: there is nothing to protect.
  publicKey      String       @unique
  /// sha256 of the sk_* key, never the key itself. Lookup is by hash, which doubles as the
  /// comparison — a database dump does not hand over working credentials.
  secretKeyHash  String       @unique
  /// Origins allowed to send chunks, and the only ones the SDK injects traceparent into.
  origins        String[]
  createdAt      DateTime     @default(now())

  sessions Session[]

  @@index([organizationId])
}

model Session {
  id        String  @id
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId    String?
  release   String?
  userAgent String?
  url       String?
  viewport  Json?

  /// serverMs - clientMs, from the NTP-style handshake in §3.5. Drawing only, never attribution.
  clockOffsetMs Int @default(0)
  rttMs         Int @default(0)

  startedAt  DateTime
  endedAt    DateTime?
  durationMs Int?
  meta       Json?

  chunks SessionChunk[]
  links  RequestLink[]

  /// The session list: newest first, per project.
  @@index([projectId, startedAt(sort: Desc)])
}

model SessionChunk {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  seq        Int
  startedAt  DateTime
  endedAt    DateTime
  eventCount Int
  sizeBytes  Int
  /// sessions/{projectId}/{sessionId}/{seq}.json.gz
  storageKey String

  /// Makes a redelivered job an upsert instead of a duplicate.
  @@unique([sessionId, seq])
}

model RequestLink {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  traceId String
  spanId  String
  method  String
  url     String
  status  Int?

  clientStartMs BigInt
  clientEndMs   BigInt

  /// Draw the network lane in order.
  @@index([sessionId, clientStartMs])
  /// The reverse lookup: given a trace id from an alert, which replay shows it?
  @@index([traceId])
}

model Span {
  traceId      String
  spanId       String
  parentSpanId String?

  name        String
  kind        String
  serviceName String

  /// OpenTelemetry is nanoseconds since epoch, which overflows Int.
  startNs    BigInt
  endNs      BigInt
  durationNs BigInt

  statusCode String?
  statusMsg  String?
  /// db.system, db.statement, http.*, and whatever else the customer's instrumentation emits.
  attributes Json

  @@id([traceId, spanId])
  /// Fetch a whole trace, already ordered.
  @@index([traceId, startNs])
  @@index([serviceName, startNs])
}

// ---------------------------------------------------------------------------------------------
// Authentication, generated by `@better-auth/cli generate` and merged here.
//
// Better Auth's session model is mapped to AuthSession: it would otherwise collide with our
// Session, which means a recording. Renaming a domain model across six packages to accommodate a
// library is the wrong trade, so the library's model is the one that moves.
//
// Do not hand-edit these. Regenerate with the CLI and re-merge if the auth config changes.
// ---------------------------------------------------------------------------------------------

model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  authsessions  AuthSession[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model AuthSession {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("AuthSession")
}

model Account {
  id                    String    @id
  /// Added by hand: better-auth 1.7.2 writes this, but @better-auth/cli@1.4.21 — the newest
  /// published CLI — does not generate it. Without it every sign-up fails after the user row is
  /// written, leaving an account nobody can log in as.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  /// Not part of Better Auth's generated schema — this is the seam where our domain attaches.
  projects    Project[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
