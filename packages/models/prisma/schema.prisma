// Syncline data model. See docs/ARCHITECTURE.md §6 for the reasoning behind the shape.
//
// Two rules this schema exists to enforce:
//   1. rrweb blobs never land in Postgres. A five-minute session is tens of megabytes of DOM
//      mutations. Postgres holds the index; object storage holds the film.
//   2. Spans are reached through the SpanStore port, never through this client directly. They are
//      the one table with unbounded write volume and the one destined for ClickHouse.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id             String       @id @default(cuid())
  name           String
  /// The tenant boundary. Every recording reaches an organization through its project.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// pk_* — ships in browser bundles. Public by construction: write-only and origin-gated,
  /// so it is stored as-is: there is nothing to protect.
  publicKey      String       @unique
  /// sha256 of the sk_* key, never the key itself. Lookup is by hash, which doubles as the
  /// comparison — a database dump does not hand over working credentials.
  secretKeyHash  String       @unique
  /// Origins allowed to send chunks, and the only ones the SDK injects traceparent into.
  origins        String[]
  createdAt      DateTime     @default(now())

  sessions Session[]

  @@index([organizationId])
}

model Session {
  id        String  @id
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId    String?
  release   String?
  userAgent String?
  url       String?
  viewport  Json?

  /// serverMs - clientMs, from the NTP-style handshake in §3.5. Drawing only, never attribution.
  clockOffsetMs Int @default(0)
  rttMs         Int @default(0)

  startedAt  DateTime
  endedAt    DateTime?
  durationMs Int?
  meta       Json?

  /// True for a recording with nothing in it: too short to watch, no requests, no failures. A
  /// label rather than a deletion — the recordings list hides these by default, and anything that
  /// failed is never marked, because that is the recording someone will come looking for.
  trivial Boolean @default(false)

  /// Counted here rather than derived, so "which sessions broke" is an indexed column instead of a
  /// join against every error a project ever recorded. Rebuilt from the rows on every chunk, which
  /// keeps a redelivered job from inflating them.
  errorCount        Int @default(0)
  consoleErrorCount Int @default(0)
  consoleWarnCount  Int @default(0)

  /// The rest of the search summary: what a list row needs, and what a filter selects on.
  ///
  /// Every one of these is derived from rows that are still there — links, chunks, spans — so the
  /// whole set can be rebuilt from the raw data if this ever computes them wrongly. They are stored
  /// rather than joined because a list of fifty recordings must not cost fifty queries, and
  /// "sessions slower than two seconds" must not mean aggregating every request in the project.
  requestCount       Int  @default(0)
  failedRequestCount Int  @default(0)
  /// The worst request the browser timed, in ms. Null when the session made none.
  slowestRequestMs   Int?

  /// Whether any of this session's traces produced spans, and from which services.
  ///
  /// Written when spans arrive rather than when the chunk does, because the export lands after the
  /// recording — often seconds after, sometimes never. False here is the honest answer to "is the
  /// backend instrumented", which is a question a new install needs answered.
  hasBackendSpans Boolean  @default(false)
  serviceNames    String[]

  /// Chunks received, and the sequence numbers that never arrived.
  ///
  /// A gap is a hole in the film. The viewer has to mark it rather than play across it, and a
  /// project accumulating gaps has an ingest problem worth seeing before its users report it.
  chunkCount       Int   @default(0)
  missingChunkSeqs Int[]

  chunks     SessionChunk[]
  links      RequestLink[]
  pageviews  Pageview[]
  errors     SessionError[]
  attributes SessionAttribute[]

  /// The session list: newest first, per project.
  @@index([projectId, startedAt(sort: Desc)])
}

/// One indexed fact about a session: `user = u_123`, `path = /checkout`, `service = checkout-api`.
///
/// A table rather than columns, and rather than searching the session's JSON, because the question
/// it answers is "find me the session where X" for an X that varies. A column per filter needs a
/// migration every time someone wants a new one, and a JSON scan reads every recording in the
/// project to answer one lookup. One narrow key/value table with a composite index answers all of
/// them at the same cost.
///
/// Multi-valued by design — a session visits many paths and touches many services — so uniqueness
/// is on the value too, which is also what makes a redelivered chunk an upsert instead of a
/// duplicate.
///
/// `projectId` is denormalized off Session on purpose: it is the first column of the lookup index,
/// and reaching it through a join would put every project's rows in the same scan.
model SessionAttribute {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  projectId String

  /// A closed vocabulary. See ATTRIBUTE_KEYS in packages/models/src/lib/session-index.ts.
  key   String
  /// Truncated at MAX_ATTRIBUTE_VALUE_CHARS. Written by a browser, so treated as untrusted text.
  value String

  @@unique([sessionId, key, value])
  /// The lookup this table exists for, scoped to a project so the index is never scanned globally.
  @@index([projectId, key, value])
  /// Read one session's attributes, and cascade its deletion.
  @@index([sessionId])
}

model SessionChunk {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  seq               Int
  startedAt         DateTime
  endedAt           DateTime
  eventCount        Int
  sizeBytes         Int
  /// Console output is counted here and summed onto the session, rather than counted onto the
  /// session directly. A chunk row is an upsert, so a redelivered job overwrites these; a counter
  /// incremented on the session would double instead. The lines themselves stay in the replay
  /// stream — there are far more of them than errors and each is worth far less.
  consoleErrorCount Int      @default(0)
  consoleWarnCount  Int      @default(0)
  /// Which page these events belong to. Chunks flush at page boundaries, so one chunk is one page —
  /// which is what lets the viewer load a single page of a long session. Null for chunks from an
  /// SDK that predates pageviews.
  pageviewOrdinal   Int?
  /// sessions/{projectId}/{sessionId}/{seq}.json.gz
  storageKey        String

  /// Makes a redelivered job an upsert instead of a duplicate.
  @@unique([sessionId, seq])
}

/// A page the session visited: one step in the user's flow.
///
/// The flow is what makes a recording navigable. Without it a session is an undifferentiated span of
/// time, and answering "where was the user when this broke" means scrubbing.
model Pageview {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Position in the flow, assigned by the SDK. Not derived from timestamps: chunks arrive out of
  /// order, and two route changes in the same millisecond are indistinguishable by time.
  ordinal Int
  /// Origin, path and query keys, plus a route-shaped fragment for hash routers.
  url     String
  /// Split out so it can be indexed and filtered on without parsing a URL per row.
  path    String
  /// What moved the user here: load, pushState, replaceState, popstate, hashchange.
  trigger String

  startedAt  DateTime
  /// Set when the next page begins, or from the session's last event for the final page. Null while
  /// the page is still the one being recorded.
  endedAt    DateTime?
  durationMs Int?

  /// Read order for the flow, and the uniqueness that makes a redelivered chunk an upsert.
  @@unique([sessionId, ordinal])
  /// "Which sessions reached /checkout" — the query the flow exists to answer.
  @@index([path])
}

/// An uncaught error the page reported, lifted out of the replay stream.
///
/// Rows rather than counts alone, because "it broke" is where an investigation starts and not
/// where it ends: the message and the frame it happened at are what turn a red mark on the
/// timeline into something someone can act on. Console output stays in the replay stream and is
/// only counted — there is far more of it, each line is worth far less, and it is already on the
/// timeline for anyone watching.
model SessionError {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// onerror or unhandledrejection. Which one matters: a rejection usually means a request failed
  /// and the interface never said so.
  source  String
  /// The constructor name, when something that had one was thrown.
  name    String?
  message String
  /// Sanitized like a request URL: the script it came from, without query values.
  fileUrl String?
  line    Int?
  column  Int?
  stack   String?

  /// Client time, the same frame of reference as the replay and the request lane.
  clientMs BigInt

  /// Draw the lane in order, and read a session's errors without a sort.
  @@index([sessionId, clientMs])
}

model RequestLink {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  traceId String
  spanId  String
  method  String
  url     String
  status  Int?

  clientStartMs BigInt
  clientEndMs   BigInt

  /// Draw the network lane in order.
  @@index([sessionId, clientStartMs])
  /// The reverse lookup: given a trace id from an alert, which replay shows it?
  @@index([traceId])
}

model Span {
  traceId      String
  spanId       String
  parentSpanId String?

  name        String
  kind        String
  serviceName String

  /// OpenTelemetry is nanoseconds since epoch, which overflows Int.
  startNs    BigInt
  endNs      BigInt
  durationNs BigInt

  statusCode String?
  statusMsg  String?
  /// db.system, db.statement, http.*, and whatever else the customer's instrumentation emits.
  attributes Json

  @@id([traceId, spanId])
  /// Fetch a whole trace, already ordered.
  @@index([traceId, startNs])
  @@index([serviceName, startNs])
}

// ---------------------------------------------------------------------------------------------
// Authentication, generated by `@better-auth/cli generate` and merged here.
//
// Better Auth's session model is mapped to AuthSession: it would otherwise collide with our
// Session, which means a recording. Renaming a domain model across six packages to accommodate a
// library is the wrong trade, so the library's model is the one that moves.
//
// Do not hand-edit these. Regenerate with the CLI and re-merge if the auth config changes.
// ---------------------------------------------------------------------------------------------

model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  authsessions  AuthSession[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model AuthSession {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("AuthSession")
}

model Account {
  id                    String    @id
  /// Added by hand: better-auth 1.7.2 writes this, but @better-auth/cli@1.4.21 — the newest
  /// published CLI — does not generate it. Without it every sign-up fails after the user row is
  /// written, leaving an account nobody can log in as.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  /// Not part of Better Auth's generated schema — this is the seam where our domain attaches.
  projects    Project[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
