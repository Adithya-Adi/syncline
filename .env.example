# Copy to .env for local development. `pnpm infra:up` brings up services matching these values.
#
# The ports are deliberately non-standard: 5442 and 6399 rather than 5432 and 6379. If you already
# run Postgres or Redis natively, the standard ports are taken, and a host connection may reach
# your local server instead of the container without any error to tell you so.

DATABASE_URL="postgresql://syncline:syncline@localhost:5442/syncline?schema=public"

REDIS_URL="redis://localhost:6399"

# MinIO speaks the S3 API. In production point these at real S3-compatible storage.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="syncline"
S3_ACCESS_KEY_ID="syncline"
S3_SECRET_ACCESS_KEY="syncline-dev-secret"
# MinIO needs path-style addressing; most cloud providers do not.
S3_FORCE_PATH_STYLE="true"

API_PORT=4000
WEB_PORT=3000

# Server-side only: the recordings list requires the secret key, and a browser must never hold it.
SYNCLINE_API="http://localhost:4000"
SYNCLINE_SECRET_KEY="sk_..."

# Baked into the browser bundle at build time. Public by design.
NEXT_PUBLIC_SYNCLINE_API="http://localhost:4000"

# Signs session cookies. Generate a fresh one per install:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"
