# Copy to .env and fill in from a project's setup page.
#
# The project's allowed origins must include this server's origin, or ingest refuses every
# recording with a 403 naming the origin it rejected.

SYNCLINE_ENDPOINT=http://localhost:4000

# pk_* — shipped to the browser. Public by design: origin-gated and write-only.
SYNCLINE_PUBLIC_KEY=

# sk_* — server side only, used to export backend spans. Shown once, when the project is created
# or its keys are rotated.
SYNCLINE_SECRET_KEY=

# Tags every recording, so a release can be compared against the one before it.
SYNCLINE_RELEASE=storefront@1.0.0

PORT=4321

# Set to 1 to stop advertising `traceparent` in Access-Control-Allow-Headers, reproducing the
# most common way a real integration appears to break the host application.
BREAK_CORS=
