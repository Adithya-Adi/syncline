# Copy to .env.local and fill in from a project's setup page.
#
# The project's allowed origins must include http://localhost:4321, or ingest refuses every
# recording with a 403 naming the origin it rejected.

# NEXT_PUBLIC_ because these reach the browser. The public key is public by design: origin-gated
# and write-only.
NEXT_PUBLIC_SYNCLINE_ENDPOINT=http://localhost:4000
NEXT_PUBLIC_SYNCLINE_PUBLIC_KEY=
NEXT_PUBLIC_SYNCLINE_RELEASE=storefront@1.0.0

# No prefix, so Next refuses to inline it into client code. Read only inside route handlers, and
# shown once — when the project is created or its keys are rotated.
SYNCLINE_SECRET_KEY=

# Set to 1 to stop advertising `traceparent` in Access-Control-Allow-Headers, reproducing the most
# common way a real integration appears to break the host application.
BREAK_CORS=
